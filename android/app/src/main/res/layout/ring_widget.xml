        <TextView
            android:id="@+id/day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:textSize="11sp"
            android:textColor="@color/widget_muted"
            android:text="" />
    </LinearLayout>

